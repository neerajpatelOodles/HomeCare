NODE_ENV=development
PORT=5000

# PostgreSQL (either DATABASE_URL or the individual DB_* values)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/homecare_central
DB_SSL=false

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Frontend origin allowed by CORS (cookies are sent with credentials)
CLIENT_ORIGIN=http://localhost:3000

# Initial admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@homecare.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin
